<Window x:Class="WorkFileExplorer.App.Dialogs.StyledDialogWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="알림"
        SizeToContent="WidthAndHeight"
        MinWidth="300"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="#FCFCFD"
        FontFamily="Malgun Gothic">
    <Grid Margin="14,12,14,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <DockPanel Grid.Row="0" LastChildFill="True">
            <Border Width="24"
                    Height="24"
                    Background="#FEF3C7"
                    BorderBrush="#F59E0B"
                    BorderThickness="1"
                    CornerRadius="12"
                    Margin="0,1,10,0"
                    VerticalAlignment="Top">
                <TextBlock Text="!"
                           FontWeight="Bold"
                           FontSize="14"
                           Foreground="#B45309"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center" />
            </Border>
            <TextBlock x:Name="MessageTextBlock"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="430"
                       FontSize="12.5"
                       LineHeight="19"
                       Foreground="#1F2937" />
        </DockPanel>

        <Grid Grid.Row="1" HorizontalAlignment="Right" Margin="0,14,0,0" KeyboardNavigation.DirectionalNavigation="Cycle">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Button x:Name="QuinaryButton"
                    Grid.Row="0"
                    Grid.Column="0"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0,0,6,5"
                    Visibility="Collapsed"
                    Click="OnQuinaryClick" />
            <Button x:Name="TertiaryButton"
                    Grid.Row="1"
                    Grid.Column="0"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0,0,6,0"
                    Visibility="Collapsed"
                    Click="OnTertiaryClick" />

            <Button x:Name="QuaternaryButton"
                    Grid.Row="0"
                    Grid.Column="1"
                    Style="{StaticResource DialogButtonStyle}"
                    Margin="0,0,6,5"
                    Visibility="Collapsed"
                    Click="OnQuaternaryClick" />
            <Button x:Name="PrimaryButton"
                    Grid.Row="1"
                    Grid.Column="1"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Margin="0,0,6,0"
                    Content="확인(O)"
                    IsDefault="True"
                    Click="OnPrimaryClick" />

            <Button x:Name="SecondaryButton"
                    Grid.Row="1"
                    Grid.Column="2"
                    Style="{StaticResource DialogButtonStyle}"
                    MinWidth="76"
                    Content="취소(N)"
                    IsCancel="True"
                    Click="OnSecondaryClick" />

            <Button x:Name="SenaryButton"
                    Grid.Row="0"
                    Grid.Column="2"
                    Style="{StaticResource DialogButtonStyle}"
                    MinWidth="76"
                    Margin="0,0,0,5"
                    Visibility="Collapsed"
                    Click="OnSenaryClick" />
        </Grid>
    </Grid>
</Window>

<Window x:Class="WorkFileExplorer.App.Dialogs.ImageResizeDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 크기 조정"
        Width="420"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F4F4"
        FontFamily="{DynamicResource UiFontFamily}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SourceText"
                   Grid.Row="0"
                   FontSize="13"
                   Foreground="#333333" />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock VerticalAlignment="Center" Text="비율" Foreground="#333333" />
            <Button Style="{StaticResource DialogButtonStyle}" Margin="8,0,0,0" MinWidth="54" Content="25%" Click="OnPreset25Click" />
            <Button Style="{StaticResource DialogButtonStyle}" Margin="6,0,0,0" MinWidth="54" Content="50%" Click="OnPreset50Click" />
            <Button Style="{StaticResource DialogButtonStyle}" Margin="6,0,0,0" MinWidth="54" Content="75%" Click="OnPreset75Click" />
            <Button Style="{StaticResource DialogButtonStyle}" Margin="6,0,0,0" MinWidth="54" Content="100%" Click="OnPreset100Click" />
        </StackPanel>

        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="가로" Foreground="#333333" />
            <TextBox x:Name="TextWidth"
                     Grid.Column="1"
                     Height="26"
                     Margin="8,0,4,0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnWidthTextChanged" />
            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="px" Margin="0,0,16,0" Foreground="#555555" />

            <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="세로" Foreground="#333333" />
            <TextBox x:Name="TextHeight"
                     Grid.Column="4"
                     Height="26"
                     Margin="8,0,4,0"
                     VerticalContentAlignment="Center"
                     TextChanged="OnHeightTextChanged" />
            <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="px" Foreground="#555555" />
        </Grid>

        <CheckBox x:Name="CheckKeepRatio"
                  Grid.Row="3"
                  Margin="0,10,0,0"
                  Content="가로세로 비율 유지"
                  Foreground="#333333"
                  IsChecked="True"
                  Checked="OnKeepRatioChanged"
                  Unchecked="OnKeepRatioChanged" />

        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="10,8"
                Background="White"
                BorderBrush="#B6B6B6"
                BorderThickness="1"
                CornerRadius="4">
            <StackPanel>
                <TextBlock x:Name="ResultText" FontWeight="SemiBold" Foreground="#1F2937" />
                <TextBlock x:Name="ResultHintText" Margin="0,4,0,0" FontSize="11" Foreground="#6B7280" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="5" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock VerticalAlignment="Center" Text="JPG 품질" Foreground="#333333" />
                <Slider x:Name="SliderQuality"
                        Width="110"
                        Margin="8,0,6,0"
                        VerticalAlignment="Center"
                        Minimum="40"
                        Maximum="100"
                        Value="92"
                        ToolTip="JPG로 저장할 때의 품질"
                        ValueChanged="OnQualityChanged" />
                <TextBlock x:Name="QualityText" VerticalAlignment="Center" Foreground="#555555" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                        Margin="0,0,6,0"
                        Content="확인"
                        IsDefault="True"
                        Click="OnConfirmClick" />
                <Button Style="{StaticResource DialogButtonStyle}"
                        Content="취소"
                        IsCancel="True"
                        Click="OnCancelClick" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>

<Window x:Class="WorkFileExplorer.App.Dialogs.FindFilesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="파일 찾기"
        Width="960"
        Height="560"
        MinWidth="820"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#ECECEC"
        FontFamily="Malgun Gothic">
    <Grid Margin="10">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="124" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Menu x:Name="TopMenu" Grid.Column="0" Grid.Row="0" Background="#ECECEC">
            <MenuItem Header="동작(A)" />
            <MenuItem Header="보기(V)" />
            <MenuItem Header="결과(R)" />
            <MenuItem Header="옵션" />
        </Menu>

        <TabControl x:Name="FindTabs" Grid.Column="0" Grid.Row="1" Margin="0,8,10,0">
            <TabItem Header="기본">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="디렉터리" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="디렉터리에서 시작(D)" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2"
                                          IsEditable="True"
                                          Text="{Binding SearchStartDirectory, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding SearchStartDirectoryHistory}"
                                          ToolTip="이전 검색에서 사용한 시작 디렉터리를 다시 선택할 수 있습니다." />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="하위 디렉터리 제외(X)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" Text="{Binding SearchExcludedDirectories, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="하위 디렉터리에서 검색(B)" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          Width="220"
                                          Margin="0,2,0,2"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding SearchDepthOptions}"
                                          SelectedItem="{Binding SearchDepthOption}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="파일" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="파일 마스크(F)" />
                                <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2"
                                          IsEditable="True"
                                          Text="{Binding SearchFileMasks, UpdateSourceTrigger=PropertyChanged}"
                                          ItemsSource="{Binding SearchFileMaskHistory}"
                                          ToolTip="이전 검색에서 사용한 파일 마스크를 다시 선택할 수 있습니다." />

                                <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="파일 제외(E)" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" Text="{Binding SearchExcludedFiles, UpdateSourceTrigger=PropertyChanged}" />

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Top" Margin="0,4,0,0" Text="마스크 프리셋" />
                                <WrapPanel Grid.Row="2" Grid.Column="1" Margin="0,4,0,0">
                                    <Button Margin="0,0,6,6" Padding="10,2" Content="전체" Tag="*" Click="OnMaskPresetClick" />
                                    <Button Margin="0,0,6,6" Padding="10,2" Content="텍스트파일" Tag="*.txt;*.md;*.csv;*.log;*.json;*.xml;*.yaml;*.yml;*.ini;*.cfg" Click="OnMaskPresetClick" />
                                    <Button Margin="0,0,6,6" Padding="10,2" Content="문서" Tag="*.doc;*.docx;*.hwp;*.hwpx;*.xls;*.xlsx;*.ppt;*.pptx;*.pdf;*.rtf;*.odt" Click="OnMaskPresetClick" />
                                    <Button Margin="0,0,6,6" Padding="10,2" Content="이미지" Tag="*.png;*.jpg;*.jpeg;*.gif;*.bmp;*.webp;*.tif;*.tiff;*.svg;*.heic;*.avif" Click="OnMaskPresetClick" />
                                    <Button Margin="0,0,6,6" Padding="10,2" Content="동영상" Tag="*.mp4;*.mkv;*.avi;*.mov;*.wmv;*.flv;*.webm;*.m4v;*.ts;*.3gp" Click="OnMaskPresetClick" />
                                </WrapPanel>

                                <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Margin="0,2,0,2">
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center"
                                              Content="정확히 일치(M)"
                                              ToolTip="체크를 해제하면 'test' 입력 시 자동으로 앞뒤에 *를 붙여 '*test*' 형태로 포함된 단어를 검색합니다. 체크 시 입력한 이름과 정확히 일치하는 파일만 찾습니다."
                                              IsChecked="{Binding SearchExactMatch}" />
                                    <CheckBox VerticalAlignment="Center"
                                              Content="폴더(디렉터리) 이름도 검색(O)"
                                              ToolTip="체크하면 파일뿐 아니라 이름이 일치하는 폴더도 결과에 표시합니다. 기본은 파일만 검색합니다."
                                              IsChecked="{Binding SearchIncludeDirectories}" />
                                </StackPanel>
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="데이터 찾기">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="파일에서 텍스트 찾기(T)" IsChecked="{Binding SearchUseTextQuery}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" Text="{Binding SearchTextQuery, UpdateSourceTrigger=PropertyChanged}" />

                                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,4,0,2">
                                    <CheckBox Margin="0,0,12,0" VerticalAlignment="Center" Content="대소문자 구분(U)" IsChecked="{Binding SearchCaseSensitive}" />
                                    <CheckBox VerticalAlignment="Center" Content="정규식(R)" IsChecked="{Binding SearchUseRegex}" />
                                </StackPanel>

                                <TextBlock Grid.Row="2" Grid.Column="0" VerticalAlignment="Center" Text="인코딩(G)" />
                                <ComboBox Grid.Row="2" Grid.Column="1"
                                          Width="160"
                                          Margin="0,2,0,2"
                                          HorizontalAlignment="Left"
                                          ItemsSource="{Binding SearchEncodings}"
                                          SelectedItem="{Binding SearchEncoding}" />
                            </Grid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="고급">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="8">
                        <GroupBox Header="파일 크기" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="다음 크기 이상(I)" IsChecked="{Binding SearchUseMinSize}" />
                                <TextBox Grid.Row="0" Grid.Column="1" Margin="0,2,0,2" VerticalContentAlignment="Center" Text="{Binding SearchMinSizeKb, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Row="0" Grid.Column="2" Width="66" Margin="6,2,0,2" ItemsSource="{Binding SearchSizeUnits}" SelectedItem="{Binding SearchMinSizeUnit}" />

                                <CheckBox Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="다음 크기 이하(Z)" IsChecked="{Binding SearchUseMaxSize}" />
                                <TextBox Grid.Row="1" Grid.Column="1" Margin="0,2,0,2" VerticalContentAlignment="Center" Text="{Binding SearchMaxSizeKb, UpdateSourceTrigger=PropertyChanged}" />
                                <ComboBox Grid.Row="1" Grid.Column="2" Width="66" Margin="6,2,0,2" ItemsSource="{Binding SearchSizeUnits}" SelectedItem="{Binding SearchMaxSizeUnit}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="날짜" Margin="0,0,0,8">
                            <Grid Margin="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <CheckBox Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Content="다음 날짜 이후(D)" IsChecked="{Binding SearchUseDateFrom}" />
                                <DatePicker Grid.Row="0" Grid.Column="1" Width="140" Margin="0,2,0,2" HorizontalAlignment="Left" SelectedDate="{Binding SearchDateFrom}" />

                                <CheckBox Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Content="다음 날짜 이전(C)" IsChecked="{Binding SearchUseDateTo}" />
                                <DatePicker Grid.Row="1" Grid.Column="1" Width="140" Margin="0,2,0,2" HorizontalAlignment="Left" SelectedDate="{Binding SearchDateTo}" />
                            </Grid>
                        </GroupBox>

                        <GroupBox Header="추가 옵션">
                            <StackPanel Margin="8">
                                <CheckBox Content="숨김 파일 제외(H)" ToolTip="숨김 속성이 있는 파일과 폴더를 검색에서 제외합니다." IsChecked="{Binding SearchExcludeHidden}" />
                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <CheckBox VerticalAlignment="Center"
                                              Content="최대 결과 개수(M)"
                                              ToolTip="체크하면 지정한 개수만큼 찾은 뒤 검색을 멈춥니다. 체크하지 않으면 제한 없이 모두 찾습니다."
                                              IsChecked="{Binding SearchUseMaxResults}" />
                                    <TextBox Width="90" Margin="8,0,0,0" VerticalContentAlignment="Center" Text="{Binding SearchMaxResultsText, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock VerticalAlignment="Center" Margin="6,0,0,0" Text="개" />
                                </StackPanel>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="플러그인">
                <TextBlock Margin="12" Text="플러그인 검색은 다음 단계에서 연결됩니다." />
            </TabItem>

            <TabItem Header="불러오기/저장">
                <TextBlock Margin="12" Text="검색 프리셋 저장과 불러오기는 다음 단계에서 연결됩니다." />
            </TabItem>

            <TabItem Header="결과">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="8,8,8,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding FindResultSummary}" />
                            <TextBlock Margin="8,0,0,0" Text="{Binding FindElapsedText}" />
                            <ProgressBar x:Name="SearchProgressBar"
                                         Width="140"
                                         Height="12"
                                         Margin="12,0,0,0"
                                         HorizontalAlignment="Left"
                                         IsIndeterminate="True"
                                         Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock Margin="0,2,0,0"
                                   FontSize="11"
                                   Foreground="#707070"
                                   TextTrimming="CharacterEllipsis"
                                   Text="{Binding FindSearchConditionText}"
                                   ToolTip="{Binding FindSearchConditionText}" />
                    </StackPanel>
                    <ListView x:Name="ResultsListView"
                              Grid.Row="1"
                              Margin="8,0,8,8"
                              ItemsSource="{Binding SearchResults}"
                              SelectionMode="Extended"
                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                              SizeChanged="OnResultsListViewSizeChanged"
                              GridViewColumnHeader.Click="OnResultsHeaderClick"
                              MouseDoubleClick="OnResultDoubleClick">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="경로" Width="620">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding FullPath}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="크기" Width="90">
                                    <GridViewColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding SizeDisplay}" HorizontalAlignment="Right" />
                                        </DataTemplate>
                                    </GridViewColumn.CellTemplate>
                                </GridViewColumn>
                                <GridViewColumn Header="날짜" Width="140" DisplayMemberBinding="{Binding LastModified, StringFormat=yyyy-MM-dd HH:mm}" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Column="1" Grid.RowSpan="2" Orientation="Vertical" Margin="0,34,0,0">
            <Button x:Name="StartSearchButton" Height="30" Margin="0,0,0,6" Content="시작(S)" IsDefault="True" Click="OnStartClick" />
            <Button Height="30" Margin="0,0,0,6" Content="닫기(C)" IsCancel="True" Click="OnCloseClick" />
            <Button Height="30" Margin="0,14,0,6" Content="새 검색(N)" Click="OnNewSearchClick" />
            <Button Height="30" Content="마지막 검색(L)" Click="OnLastSearchClick" />
        </StackPanel>
    </Grid>
</Window>

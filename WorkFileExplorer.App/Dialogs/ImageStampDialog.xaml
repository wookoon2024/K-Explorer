<Window x:Class="WorkFileExplorer.App.Dialogs.ImageStampDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="텍스트 도장"
        Width="440"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F4F4F4"
        FontFamily="{DynamicResource UiFontFamily}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="13" Foreground="#333333" Text="이미지 위에 표시할 문구를 입력하세요." />

        <TextBox x:Name="TextStamp"
                 Grid.Row="1"
                 Height="26"
                 Margin="0,10,0,0"
                 VerticalContentAlignment="Center"
                 TextChanged="OnStampTextChanged" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,8,0,0">
            <Button Style="{StaticResource DialogButtonStyle}" MinWidth="86" Content="파일 이름" Click="OnPresetFileNameClick" />
            <Button Style="{StaticResource DialogButtonStyle}" Margin="6,0,0,0" MinWidth="86" Content="오늘 날짜" Click="OnPresetDateClick" />
            <Button Style="{StaticResource DialogButtonStyle}" Margin="6,0,0,0" MinWidth="120" Content="파일 이름 + 날짜" Click="OnPresetFileNameDateClick" />
        </StackPanel>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="위치" Foreground="#333333" />
            <ComboBox x:Name="ComboPosition"
                      Grid.Column="1"
                      Height="26"
                      Margin="8,0,16,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="OnSelectionChanged" />

            <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="글자 크기" Foreground="#333333" />
            <ComboBox x:Name="ComboSize"
                      Grid.Column="3"
                      Height="26"
                      Margin="8,0,0,0"
                      VerticalContentAlignment="Center"
                      SelectionChanged="OnSelectionChanged" />
        </Grid>

        <CheckBox x:Name="CheckBackground"
                  Grid.Row="4"
                  Margin="0,10,0,0"
                  Content="글자 뒤에 반투명 배경 넣기"
                  Foreground="#333333"
                  IsChecked="True"
                  Checked="OnBackgroundChanged"
                  Unchecked="OnBackgroundChanged" />

        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Padding="10,8"
                Background="White"
                BorderBrush="#B6B6B6"
                BorderThickness="1"
                CornerRadius="4">
            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" Foreground="#1F2937" />
        </Border>

        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Style="{StaticResource DialogPrimaryButtonStyle}"
                    Margin="0,0,6,0"
                    Content="저장..."
                    IsDefault="True"
                    Click="OnConfirmClick" />
            <Button Style="{StaticResource DialogButtonStyle}"
                    Content="취소"
                    IsCancel="True"
                    Click="OnCancelClick" />
        </StackPanel>
    </Grid>
</Window>

<Window x:Class="WorkFileExplorer.App.Dialogs.ImageViewerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이미지 뷰어"
        FontFamily="{DynamicResource UiFontFamily}"
        Width="1200"
        Height="820"
        MinWidth="700"
        MinHeight="460"
        Background="#1E1E1E"
        Foreground="#F0F0F0"
        WindowStartupLocation="CenterOwner"
        AllowDrop="True"
        Drop="OnWindowDrop"
        KeyDown="OnWindowKeyDown"
        SizeChanged="OnWindowSizeChanged">
    <Window.Resources>
        <Style x:Key="ViewerToolbarButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="Foreground" Value="#E6E9EC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E353D" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3E464F" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#151A1F" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4A5560" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerGlyphButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="13" />
        </Style>

        <Style x:Key="ViewerSymbolButtonStyle" TargetType="Button" BasedOn="{StaticResource ViewerToolbarButtonStyle}">
            <Setter Property="MinWidth" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontFamily" Value="Segoe UI Symbol" />
            <Setter Property="FontSize" Value="15" />
        </Style>

        <Style x:Key="ViewerHandleButtonStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="#9FB6CC" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#26303A" />
                                <Setter Property="Foreground" Value="#EAF4FF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E6FBF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerToggleButtonStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="26" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="MinWidth" Value="44" />
            <Setter Property="Margin" Value="3,0,0,0" />
            <Setter Property="Padding" Value="9,1" />
            <Setter Property="Foreground" Value="#E6E9EC" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4"
                                SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2E353D" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#3E464F" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2A4E78" />
                                <Setter TargetName="Root" Property="BorderBrush" Value="#4A8FD4" />
                                <Setter Property="Foreground" Value="#FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerToolbarDividerStyle" TargetType="Rectangle">
            <Setter Property="Width" Value="1" />
            <Setter Property="Margin" Value="7,4" />
            <Setter Property="Fill" Value="#3A424B" />
        </Style>

        <!-- Floating previous/next buttons that sit on top of the image. -->
        <Style x:Key="ViewerOverlayNavButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="46" />
            <Setter Property="Margin" Value="12,0" />
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#EDF3F9" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Opacity" Value="0.42" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Chrome"
                                     Fill="#B315191E"
                                     Stroke="#43505C"
                                     StrokeThickness="1" />
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="#F01B2129" />
                                <Setter TargetName="Chrome" Property="Stroke" Value="#6FB3F2" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Fill" Value="#F02A4E78" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Opacity" Value="1" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <!-- Flat slider: rounded rail, accent progress and a round grip. -->
        <Style x:Key="ViewerSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="22" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center">
                            <Border Height="6"
                                    CornerRadius="3"
                                    Background="#1F252C"
                                    BorderBrush="#2E353D"
                                    BorderThickness="1" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border CornerRadius="3">
                                                    <Border.Background>
                                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                            <GradientStop Offset="0" Color="#3B76BC" />
                                                            <GradientStop Offset="1" Color="#6FB3F2" />
                                                        </LinearGradientBrush>
                                                    </Border.Background>
                                                </Border>
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="14" Height="14">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse x:Name="Grip"
                                                         Fill="#E9EFF6"
                                                         Stroke="#7C93AA"
                                                         StrokeThickness="1" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="Grip" Property="Fill" Value="#FFFFFF" />
                                                        <Setter TargetName="Grip" Property="Stroke" Value="#6FB3F2" />
                                                    </Trigger>
                                                    <Trigger Property="IsDragging" Value="True">
                                                        <Setter TargetName="Grip" Property="Fill" Value="#8CC6FF" />
                                                        <Setter TargetName="Grip" Property="Stroke" Value="#FFFFFF" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Opacity" Value="0.45" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="ViewerSliderValueTextStyle" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="#9FB6CC" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="Margin" Value="6,0,12,0" />
            <Setter Property="MinWidth" Value="34" />
        </Style>

        <!-- Slim scroll bars: only shown when the image really overflows the viewport. -->
        <Style x:Key="ViewerScrollBarThumbStyle" TargetType="Thumb">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Thumb">
                        <Border x:Name="Bar" Margin="2" CornerRadius="3" Background="#59FFFFFF" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#A6FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsDragging" Value="True">
                                <Setter TargetName="Bar" Property="Background" Value="#D9FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ViewerScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Width" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Background="Transparent">
                            <Track x:Name="PART_Track" Orientation="Vertical" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton x:Name="DecreaseButton"
                                                  Command="ScrollBar.PageUpCommand"
                                                  Focusable="False"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource ViewerScrollBarThumbStyle}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton x:Name="IncreaseButton"
                                                  Command="ScrollBar.PageDownCommand"
                                                  Focusable="False"
                                                  Opacity="0">
                                        <RepeatButton.Template>
                                            <ControlTemplate TargetType="RepeatButton">
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                            </Track>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Orientation" Value="Horizontal">
                                <Setter TargetName="PART_Track" Property="Orientation" Value="Horizontal" />
                                <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
                                <Setter TargetName="DecreaseButton" Property="Command" Value="ScrollBar.PageLeftCommand" />
                                <Setter TargetName="IncreaseButton" Property="Command" Value="ScrollBar.PageRightCommand" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" />
                    <Setter Property="Height" Value="10" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid x:Name="RootGrid" Margin="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <Grid x:Name="TopArea" Grid.Row="0" Margin="0,0,0,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock x:Name="TopPathText"
                       Grid.Row="0"
                       Margin="3,0,3,6"
                       VerticalAlignment="Center"
                       FontSize="13"
                       Foreground="#D8DDE3"
                       TextTrimming="CharacterEllipsis" />

            <Border Grid.Row="1"
                    Background="#171B20"
                    BorderBrush="#2E353D"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="5,4">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE74E;" ToolTip="저장 (Ctrl+S)" Click="OnOpenAttachedMenuClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="다른 이름으로 저장..." Click="OnSaveImageClick" InputGestureText="Ctrl+S" />
                                    <MenuItem Header="현재 파일에 덮어쓰기" Click="OnOverwriteImageClick" />
                                    <Separator />
                                    <MenuItem Header="크기 조정 후 저장..." Click="OnResizeSaveClick" />
                                    <MenuItem Header="텍스트 도장 넣어 저장..." Click="OnStampSaveClick" />
                                    <MenuItem Header="현재 폴더 일괄 변환..." Click="OnBatchConvertClick" />
                                    <Separator />
                                    <MenuItem Header="이미지를 클립보드로 복사" Click="OnCopyImageClick" InputGestureText="Ctrl+C" />
                                    <MenuItem Header="인쇄..." Click="OnPrintClick" InputGestureText="Ctrl+P" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE8C8;" ToolTip="클립보드로 복사 (Ctrl+C)" Click="OnCopyImageClick" />
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE749;" ToolTip="인쇄 (Ctrl+P)" Click="OnPrintClick" />
                        <Rectangle Style="{StaticResource ViewerToolbarDividerStyle}" />
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE946;" ToolTip="파일 정보 (I)" Click="OnShowInfoClick" />
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE712;" ToolTip="더보기" Click="OnOpenAttachedMenuClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="이름 바꾸기" Click="OnRenameImageClick" InputGestureText="F2" />
                                    <MenuItem Header="휴지통으로 이동" Click="OnDeleteImageMenuClick" InputGestureText="Del" />
                                    <Separator />
                                    <MenuItem Header="폴더 열기" Click="OnOpenFolderClick" />
                                    <MenuItem Header="연결 프로그램으로 열기" Click="OnOpenWithDefaultAppClick" />
                                    <Separator />
                                    <MenuItem Header="전체 화면" Click="OnToggleFullScreenClick" InputGestureText="F11" />
                                    <MenuItem Header="단축키 도움말" Click="OnShowHelpClick" InputGestureText="F1" />
                                    <Separator />
                                    <MenuItem x:Name="CheckNearestNeighbor" Header="픽셀 선명 (보간 없이)" IsCheckable="True" Checked="OnImageOptionChanged" Unchecked="OnImageOptionChanged" />
                                    <MenuItem x:Name="CheckCheckerBackground" Header="투명 배경 격자" IsCheckable="True" Checked="OnImageOptionChanged" Unchecked="OnImageOptionChanged" />
                                    <MenuItem x:Name="CheckWheelZoom" Header="휠로 확대·축소" IsCheckable="True" Checked="OnImageOptionChanged" Unchecked="OnImageOptionChanged" />
                                    <MenuItem x:Name="CheckComparePrevious" Header="이전 이미지와 비교" IsCheckable="True" Checked="OnCompareOptionChanged" Unchecked="OnCompareOptionChanged" />
                                    <Separator />
                                    <MenuItem Header="회전·반전 초기화" Click="OnResetTransformClick" />
                                    <MenuItem Header="밝기·대비·감마 초기화" Click="OnResetAdjustmentsClick" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal">
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE76B;" ToolTip="이전 이미지 (←)" Click="OnPrevClick" />
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE76C;" ToolTip="다음 이미지 (→)" Click="OnNextClick" />
                        <Rectangle Style="{StaticResource ViewerToolbarDividerStyle}" />
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE738;" ToolTip="축소 (Ctrl+-)" Click="OnZoomOutClick" />
                        <Button Style="{StaticResource ViewerToolbarButtonStyle}" MinWidth="64" ToolTip="배율·맞춤 선택" Click="OnOpenAttachedMenuClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="ZoomText" Text="맞춤" VerticalAlignment="Center" />
                                <TextBlock Margin="5,0,0,0" FontSize="8" VerticalAlignment="Center" Text="▼" />
                            </StackPanel>
                            <Button.ContextMenu>
                                <ContextMenu x:Name="ZoomPresetMenu">
                                    <MenuItem x:Name="MenuZoomFit" Header="창에 맞춤" IsCheckable="True" IsChecked="True" Click="OnFitClick" InputGestureText="Ctrl+0" />
                                    <MenuItem x:Name="MenuZoomActual" Header="원본 크기 (100%)" IsCheckable="True" Click="OnActualSizeClick" InputGestureText="Ctrl+1" />
                                    <Separator />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                        <Button Style="{StaticResource ViewerGlyphButtonStyle}" Content="&#xE710;" ToolTip="확대 (Ctrl++)" Click="OnZoomInClick" />
                        <Rectangle Style="{StaticResource ViewerToolbarDividerStyle}" />
                        <Button Style="{StaticResource ViewerSymbolButtonStyle}" Content="↺" ToolTip="왼쪽으로 회전 (L)" Click="OnRotateLeftClick" />
                        <Button Style="{StaticResource ViewerSymbolButtonStyle}" Content="↻" ToolTip="오른쪽으로 회전 (R)" Click="OnRotateRightClick" />
                        <Button Style="{StaticResource ViewerSymbolButtonStyle}" Content="⇄" ToolTip="좌우 반전 (H)" Click="OnFlipClick" />
                        <Rectangle Style="{StaticResource ViewerToolbarDividerStyle}" />
                        <ToggleButton x:Name="ButtonAdjust" Style="{StaticResource ViewerToggleButtonStyle}" Content="보정" ToolTip="밝기·대비·감마·기울기 보정" />
                        <Button x:Name="SlideshowButton" Style="{StaticResource ViewerSymbolButtonStyle}" Margin="3,0,0,0" ToolTip="자동 넘김 (Ctrl+Space)" Click="OnToggleSlideshowClick">
                            <TextBlock x:Name="SlideshowGlyph" Text="▶" />
                        </Button>
                        <Button Style="{StaticResource ViewerToolbarButtonStyle}" MinWidth="52" ToolTip="자동 넘김 간격" Click="OnOpenAttachedMenuClick">
                            <TextBlock x:Name="SlideshowIntervalText" Text="3초" />
                            <Button.ContextMenu>
                                <ContextMenu x:Name="SlideshowIntervalMenu" />
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border x:Name="AdjustPanel"
                    Grid.Row="2"
                    Margin="0,6,0,0"
                    Padding="8,7"
                    Background="#171B20"
                    BorderBrush="#2E353D"
                    BorderThickness="1"
                    CornerRadius="6">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChecked, ElementName=ButtonAdjust}" Value="True">
                                <Setter Property="Visibility" Value="Visible" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center" Foreground="#C8CED6" FontSize="12" Text="밝기" />
                    <Slider x:Name="SliderBrightness"
                            Width="110"
                            Margin="8,0,0,0"
                            Style="{StaticResource ViewerSliderStyle}"
                            Minimum="-100"
                            Maximum="100"
                            Value="0"
                            ToolTip="밝기 (-100 ~ +100)"
                            ValueChanged="OnAdjustmentChanged" />
                    <TextBlock x:Name="BrightnessValueText" Style="{StaticResource ViewerSliderValueTextStyle}" />
                    <TextBlock VerticalAlignment="Center" Foreground="#C8CED6" FontSize="12" Text="대비" />
                    <Slider x:Name="SliderContrast"
                            Width="110"
                            Margin="8,0,0,0"
                            Style="{StaticResource ViewerSliderStyle}"
                            Minimum="-100"
                            Maximum="100"
                            Value="0"
                            ToolTip="대비 (-100 ~ +100)"
                            ValueChanged="OnAdjustmentChanged" />
                    <TextBlock x:Name="ContrastValueText" Style="{StaticResource ViewerSliderValueTextStyle}" />
                    <TextBlock VerticalAlignment="Center" Foreground="#C8CED6" FontSize="12" Text="감마" />
                    <Slider x:Name="SliderGamma"
                            Width="110"
                            Margin="8,0,0,0"
                            Style="{StaticResource ViewerSliderStyle}"
                            Minimum="10"
                            Maximum="300"
                            Value="100"
                            ToolTip="감마 (10% ~ 300%)"
                            ValueChanged="OnAdjustmentChanged" />
                    <TextBlock x:Name="GammaValueText" Style="{StaticResource ViewerSliderValueTextStyle}" />
                    <TextBlock VerticalAlignment="Center" Foreground="#C8CED6" FontSize="12" Text="기울기" />
                    <Slider x:Name="SliderFreeRotation"
                            Width="100"
                            Margin="8,0,0,0"
                            Style="{StaticResource ViewerSliderStyle}"
                            Minimum="-45"
                            Maximum="45"
                            Value="0"
                            ToolTip="미세 회전 (-45° ~ +45°)"
                            ValueChanged="OnFreeRotationChanged" />
                    <TextBlock x:Name="FreeRotationValueText" Style="{StaticResource ViewerSliderValueTextStyle}" />
                    <Button Style="{StaticResource ViewerToolbarButtonStyle}"
                            MinWidth="66"
                            Content="보정 초기화"
                            ToolTip="밝기/대비/감마/기울기를 되돌립니다"
                            Click="OnResetAdjustmentsClick" />
                    <Rectangle Style="{StaticResource ViewerToolbarDividerStyle}" />
                    <TextBlock x:Name="AdjustInfoText"
                               VerticalAlignment="Center"
                               Foreground="#9FB6CC"
                               FontSize="11" />
                </StackPanel>
            </Border>
        </Grid>


        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="FolderListColumn" Width="220" />
                <ColumnDefinition x:Name="FolderListHandleColumn" Width="18" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="FolderListPanel"
                    Grid.Column="0"
                    Background="#101317"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1,1,0,1">
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="7,6,7,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="FolderListTitleText"
                                   Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Foreground="#D8DDE3"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Text="파일목록"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="FolderListCountText"
                                   Grid.Column="1"
                                   Margin="6,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="#9FB6CC"
                                   FontSize="11" />
                    </Grid>
                    <ListBox x:Name="FolderList"
                             Background="Transparent"
                             AutomationProperties.Name="파일 목록"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionChanged="OnFolderListSelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="7,3" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="Foreground" Value="#B6BFC9" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="ToolTip" Value="{Binding Name}" />
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#1C222A" />
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="Background" Value="#204A7A" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                    </Trigger>
                                    <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                        <Setter Property="Background" Value="#2E6FBF" />
                                        <Setter Property="Foreground" Value="#FFFFFF" />
                                        <Setter Property="FontWeight" Value="SemiBold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontSize="12" TextTrimming="CharacterEllipsis" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <Border x:Name="FolderListHandleHost"
                    Grid.Column="1"
                    Background="#171B20"
                    BorderBrush="#3D3D3D"
                    BorderThickness="1,1,1,1">
                <Button x:Name="FolderListHandleButton"
                        Style="{StaticResource ViewerHandleButtonStyle}"
                        ToolTip="파일 목록 접기"
                        AutomationProperties.Name="파일 목록 접기"
                        Click="OnToggleFolderListClick">
                    <TextBlock x:Name="FolderListHandleGlyph"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="11"
                               Text="&#xE76B;" />
                </Button>
            </Border>

            <Border x:Name="ImageArea"
                Grid.Column="2"
                Background="#0B0B0B"
                BorderBrush="#404040"
                BorderThickness="1"
                PreviewMouseLeftButtonDown="OnImageAreaPreviewMouseLeftButtonDown"
                PreviewMouseDown="OnImageAreaPreviewMouseDown"
                PreviewMouseUp="OnImageAreaPreviewMouseUp"
                MouseMove="OnImageAreaMouseMove">
            <Border.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="정보(I)" Click="OnShowInfoClick" />
                    <MenuItem x:Name="MenuToggleFolderList" Header="파일 목록" IsCheckable="True" IsChecked="True" Click="OnToggleFolderListClick" />
                    <Separator />
                    <MenuItem Header="클립보드로 복사" Click="OnCopyImageClick" />
                    <MenuItem Header="다른 이름으로 저장" Click="OnSaveImageClick" />
                    <MenuItem Header="현재 파일에 덮어쓰기" Click="OnOverwriteImageClick" />
                    <Separator />
                    <MenuItem Header="이름 바꾸기(F2)" Click="OnRenameImageClick" />
                    <MenuItem Header="휴지통으로 이동(Del)" Click="OnDeleteImageMenuClick" />
                    <Separator />
                    <MenuItem Header="폴더 열기" Click="OnOpenFolderClick" />
                    <MenuItem Header="연결 프로그램으로 열기" Click="OnOpenWithDefaultAppClick" />
                    <Separator />
                    <MenuItem Header="크기 조정 후 저장..." Click="OnResizeSaveClick" />
                    <MenuItem Header="텍스트 도장 넣어 저장..." Click="OnStampSaveClick" />
                    <MenuItem Header="현재 폴더 일괄 변환..." Click="OnBatchConvertClick" />
                    <Separator />
                    <MenuItem Header="전체화면(F11)" Click="OnToggleFullScreenClick" />
                    <MenuItem Header="회전·반전 초기화" Click="OnResetTransformClick" />
                    <MenuItem Header="밝기·대비·감마 초기화" Click="OnResetAdjustmentsClick" />
                </ContextMenu>
            </Border.ContextMenu>
            <Grid>
                <ScrollViewer x:Name="ImageScrollViewer"
                              HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Hidden"
                              HorizontalContentAlignment="Center"
                              VerticalContentAlignment="Center"
                              PreviewMouseWheel="OnImagePreviewMouseWheel">
                    <ScrollViewer.Resources>
                        <Style TargetType="ScrollBar" BasedOn="{StaticResource ViewerScrollBarStyle}" />
                    </ScrollViewer.Resources>
                    <Grid>
                        <Rectangle x:Name="CheckerBackground" Visibility="Collapsed">
                            <Rectangle.Fill>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="#3E3E3E" Geometry="M0,0 L16,0 16,16 0,16Z" />
                                            <GeometryDrawing Brush="#2B2B2B" Geometry="M0,0 L8,0 8,8 0,8Z M8,8 L16,8 16,16 8,16Z" />
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <Image x:Name="ViewerImage"
                               Stretch="Fill"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               RenderOptions.BitmapScalingMode="HighQuality" />
                    </Grid>
                </ScrollViewer>

                <Button x:Name="NavPrevButton"
                        Style="{StaticResource ViewerOverlayNavButtonStyle}"
                        Content="&#xE76B;"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        ToolTip="이전 이미지 (←)"
                        Click="OnPrevClick" />
                <Button x:Name="NavNextButton"
                        Style="{StaticResource ViewerOverlayNavButtonStyle}"
                        Content="&#xE76C;"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        ToolTip="다음 이미지 (→)"
                        Click="OnNextClick" />
            </Grid>
            </Border>
        </Grid>

        <DockPanel x:Name="InfoPanel" Grid.Row="2" Margin="0,8,0,0">
            <TextBlock x:Name="ImageInfoText"
                       DockPanel.Dock="Right"
                       VerticalAlignment="Center"
                       Foreground="#CFCFCF" />
        </DockPanel>

        <Border x:Name="ThumbnailPanel" Grid.Row="3" Margin="0,8,0,0" Background="#111111" BorderBrush="#3D3D3D" BorderThickness="1" Padding="4">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="2,0,2,4">
                    <TextBlock VerticalAlignment="Center" Foreground="#CFCFCF" FontSize="11" Text="썸네일 크기" />
                    <Slider x:Name="SliderThumbSize"
                            Width="150"
                            Margin="8,0,0,0"
                            Style="{StaticResource ViewerSliderStyle}"
                            Minimum="60"
                            Maximum="200"
                            Value="90"
                            ToolTip="썸네일 크기 (60 ~ 200)"
                            ValueChanged="OnThumbnailSizeChanged" />
                    <TextBlock x:Name="ThumbSizeValueText" Style="{StaticResource ViewerSliderValueTextStyle}" />
                    <TextBlock x:Name="ThumbCountText"
                               Margin="10,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="#9FB6CC"
                               FontSize="11" />
                </StackPanel>
            <ListBox x:Name="ThumbnailList"
                     Background="#111111"
                     AutomationProperties.Name="썸네일"
                     BorderThickness="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     ScrollViewer.CanContentScroll="True"
                     SelectionChanged="OnThumbnailSelectionChanged"
                     PreviewMouseWheel="OnThumbnailPreviewMouseWheel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,6,0" />
                        <Setter Property="Padding" Value="2" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderBrush" Value="#4E4E4E" />
                        <Setter Property="BorderThickness" Value="1" />
                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#204A7A" />
                                <Setter Property="BorderBrush" Value="#4FA5FF" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <StackPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Width="{Binding ThumbnailItemWidth, RelativeSource={RelativeSource AncestorType=Window}}">
                            <Border Width="{Binding ThumbnailBoxWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                                    Height="{Binding ThumbnailBoxHeight, RelativeSource={RelativeSource AncestorType=Window}}"
                                    HorizontalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="#050505" />
                                        <Setter Property="BorderBrush" Value="#2C2C2C" />
                                        <Setter Property="BorderThickness" Value="1" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Background" Value="#0E2436" />
                                                <Setter Property="BorderBrush" Value="#4FA5FF" />
                                                <Setter Property="BorderThickness" Value="2" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Image Source="{Binding Thumbnail}"
                                       Stretch="Uniform"
                                       RenderOptions.BitmapScalingMode="HighQuality" />
                            </Border>
                            <TextBlock Margin="2,4,2,0"
                                       Text="{Binding Name}"
                                       FontSize="11"
                                       TextAlignment="Center"
                                       TextTrimming="CharacterEllipsis">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="#CFCFCF" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                                <Setter Property="Foreground" Value="#8FD0FF" />
                                                <Setter Property="FontWeight" Value="SemiBold" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            </DockPanel>
        </Border>
    </Grid>
</Window>
